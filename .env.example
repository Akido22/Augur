# Переменные окружения Augur — соответствуют src/augur/config/settings.py (ARCHITECTURE.md §2.2).
# Скопируйте в .env и раскомментируйте нужные строки. Значения в этом файле не хранятся.
# Пустое значение (VAR=) для числовых/булевых полей ломает валидацию — оставляйте строку закомментированной.
# Вложенные поля — через двойное подчёркивание: RISK__MAX_DAILY_LOSS_PCT, FUSION__ENABLED.

# --- Обязательно ---
# API_AUTH_TOKEN=

# --- Режим и БД (по умолчанию PAPER) ---
# TRADING_MODE=PAPER
# MAX_ALLOWED_MODE=PAPER
# DB_PATH=data/augur.db

# --- Крипто (CCXT) ---
# CCXT_EXCHANGE=binance
# CCXT_API_KEY=
# CCXT_API_SECRET=
# CCXT_SANDBOX=true                # true — testnet; реальные деньги только при явном false
# CCXT_QUOTE_CURRENCY=USDT

# --- Режимы (0.7.0) ---
# MODE__CODE_TTL_S=120             # одноразовый код mode set / orders approve
# MODE__MIN_MICRO_TRADES=20        # promotion MICRO_LIVE → FULL_AUTO

# --- Форекс (MetaTrader 5) ---
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_SERVER_UTC_OFFSET=0          # часы: время сервера брокера минус UTC

# --- Акции (Alpaca) ---
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER=true

# --- Уведомления ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Новости ---
# FINNHUB_API_KEY=
# NEWSAPI_API_KEY=
# ALPHAVANTAGE_API_KEY=
# NEWS__FINNHUB_CATEGORIES=["crypto"]          # crypto | general | forex | merger
# NEWS__LOOKBACK_H=6                           # окно первого fetch
# NEWS__TIMEOUT_S=10
# NEWS__SUMMARY_MAX_CHARS=1000
# NEWS__SYMBOL_ALIASES={"BTC/USDT": ["bitcoin"], "ETH/USDT": ["ethereum", "ether"]}
# NEWS__SOURCE_WEIGHTS={"finnhub": 1.0}
# NEWS__RULES=[...]                            # JSON-список правил (ARCHITECTURE.md §8.4); по умолчанию — 3 правила

# --- Risk Gate (ARCHITECTURE.md §7.2; лимиты меняет только человек) ---
# RISK__MAX_POSITION_PCT_EQUITY=0.02
# RISK__MAX_DAILY_LOSS_PCT=0.03
# RISK__RISK_PER_TRADE_PCT=0.005
# RISK__MAX_SPREAD_BPS=30
# RISK__MICRO_LIVE_MAX_NOTIONAL=20
# RISK__BLOCKING_FLAGS=["news_halt"]
# RISK__BLOCKING_FLAGS_BY_MODE={"MICRO_LIVE": ["fusion_contrarian"]}
# RISK__SOFT_FLAGS=["news_mixed", "high_vol"]
# RISK__RISK_FLAG_MULTIPLIER=0.5
# RISK__REDUCE_FRACTION=0.5

# --- Fusion (клиент; ключи LLM живут только в процессе Fusion, ML_LLM_FUSION_SPEC.md §3.6) ---
# FUSION__ENABLED=false
# FUSION__ENDPOINT=
# FUSION__INVALID_RATIO=0.5            # CB: доля невалидных fused_signal в окне
# FUSION__INVALID_WINDOW=20

# --- Исполнение PAPER (ARCHITECTURE.md §7.3; издержки общие с бэктестом, в %) ---
# EXECUTION__COMMISSION_PCT=0.1
# EXECUTION__SLIPPAGE_PCT=0.05
# EXECUTION__PARTIAL_TIMEOUT_S=60
# EXECUTION__RECONCILE_INTERVAL_S=30
# EXECUTION__PAPER_START_CASH=10000

# --- Circuit breaker (ARCHITECTURE.md §7.4) ---
# CB__FLATTEN_ON_TRIP=false
# CB__ADAPTER_ERROR_WINDOW_S=300
# CB__ADAPTER_ERROR_MAX=5
# CB__RESET_CODE_TTL_S=120
